{
  "name": "@yolk-sdk/mcp",
  "version": "0.0.1-canary.3",
  "description": "MCP client, server, and protocol utilities for Yolk agent runtimes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magoz/yolk-sdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/magoz/yolk-sdk/issues"
  },
  "homepage": "https://github.com/magoz/yolk-sdk#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "tools",
    "effect"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/node": {
      "types": "./src/client/node.ts",
      "default": "./src/client/node.ts"
    },
    "./protocol": {
      "types": "./src/client/protocol.ts",
      "default": "./src/client/protocol.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./client": {
        "types": "./dist/client/index.d.mts",
        "import": "./dist/client/index.mjs",
        "default": "./dist/client/index.mjs"
      },
      "./client/node": {
        "types": "./dist/client/node.d.mts",
        "import": "./dist/client/node.mjs",
        "default": "./dist/client/node.mjs"
      },
      "./protocol": {
        "types": "./dist/client/protocol.d.mts",
        "import": "./dist/client/protocol.mjs",
        "default": "./dist/client/protocol.mjs"
      },
      "./server": {
        "types": "./dist/server/index.d.mts",
        "import": "./dist/server/index.mjs",
        "default": "./dist/server/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@yolk-sdk/agent": "workspace:^",
    "effect": "catalog:"
  }
}
