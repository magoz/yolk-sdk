{
  "name": "@yolk-sdk/emulators",
  "version": "0.1.0-canary.95",
  "description": "Experimental emulators for outside services: an Effect HttpClient router, Vercel AI Gateway, OpenAI Chat Completions, Anthropic Messages, and OpenAI Responses (Codex, xAI Grok) fetch-handler emulators, and a loopback Node server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magoz/yolk-sdk.git",
    "directory": "packages/emulators"
  },
  "bugs": {
    "url": "https://github.com/magoz/yolk-sdk/issues"
  },
  "homepage": "https://github.com/magoz/yolk-sdk#readme",
  "keywords": [
    "emulators",
    "conformance",
    "testing",
    "http",
    "effect"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    },
    "./gateway": {
      "types": "./src/gateway.ts",
      "default": "./src/gateway.ts"
    },
    "./openai": {
      "types": "./src/openai.ts",
      "default": "./src/openai.ts"
    },
    "./anthropic": {
      "types": "./src/anthropic.ts",
      "default": "./src/anthropic.ts"
    },
    "./codex": {
      "types": "./src/codex.ts",
      "default": "./src/codex.ts"
    },
    "./xai": {
      "types": "./src/xai.ts",
      "default": "./src/xai.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      "./router": {
        "types": "./dist/router.d.mts",
        "import": "./dist/router.mjs",
        "default": "./dist/router.mjs"
      },
      "./gateway": {
        "types": "./dist/gateway.d.mts",
        "import": "./dist/gateway.mjs",
        "default": "./dist/gateway.mjs"
      },
      "./openai": {
        "types": "./dist/openai.d.mts",
        "import": "./dist/openai.mjs",
        "default": "./dist/openai.mjs"
      },
      "./anthropic": {
        "types": "./dist/anthropic.d.mts",
        "import": "./dist/anthropic.mjs",
        "default": "./dist/anthropic.mjs"
      },
      "./codex": {
        "types": "./dist/codex.d.mts",
        "import": "./dist/codex.mjs",
        "default": "./dist/codex.mjs"
      },
      "./xai": {
        "types": "./dist/xai.d.mts",
        "import": "./dist/xai.mjs",
        "default": "./dist/xai.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs",
        "default": "./dist/node.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@yolk-sdk/agent": "workspace:^",
    "@yolk-sdk/conformance": "workspace:^"
  }
}
