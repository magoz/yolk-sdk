{
  "name": "@yolk-sdk/anthropic",
  "version": "0.0.1-canary.4",
  "description": "Anthropic Claude OAuth and provider mechanics for Yolk hosts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magoz/yolk-sdk.git",
    "directory": "packages/anthropic"
  },
  "bugs": {
    "url": "https://github.com/magoz/yolk-sdk/issues"
  },
  "homepage": "https://github.com/magoz/yolk-sdk#readme",
  "keywords": [
    "anthropic",
    "claude",
    "oauth",
    "agent",
    "effect"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./claude": {
      "types": "./src/claude.ts",
      "default": "./src/claude.ts"
    },
    "./claude-provider": {
      "types": "./src/claude-provider.ts",
      "default": "./src/claude-provider.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./claude": {
        "types": "./dist/claude.d.mts",
        "import": "./dist/claude.mjs",
        "default": "./dist/claude.mjs"
      },
      "./claude-provider": {
        "types": "./dist/claude-provider.d.mts",
        "import": "./dist/claude-provider.mjs",
        "default": "./dist/claude-provider.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@yolk-sdk/agent": "workspace:^",
    "@yolk-sdk/oauth": "workspace:^",
    "effect": "catalog:"
  }
}
