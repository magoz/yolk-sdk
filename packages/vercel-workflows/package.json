{
  "name": "@yolk-sdk/vercel-workflows",
  "version": "0.1.0-canary.142",
  "description": "Vercel Workflow orchestration primitives for Yolk agent loops, plus a Workflow-compatible durable runtime on Cloudflare Durable Objects.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magoz/yolk-sdk.git",
    "directory": "packages/vercel-workflows"
  },
  "bugs": {
    "url": "https://github.com/magoz/yolk-sdk/issues"
  },
  "homepage": "https://github.com/magoz/yolk-sdk#readme",
  "keywords": [
    "vercel",
    "workflow",
    "agents",
    "runtime",
    "effect",
    "cloudflare",
    "durable-objects"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workflow": {
      "types": "./src/workflow.ts",
      "default": "./src/workflow.ts"
    },
    "./effect": {
      "types": "./src/effect.ts",
      "default": "./src/effect.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    },
    "./cloudflare": {
      "types": "./src/cloudflare/index.ts",
      "default": "./src/cloudflare/index.ts"
    },
    "./cloudflare/workflow": {
      "types": "./src/cloudflare/workflow.ts",
      "default": "./src/cloudflare/workflow.ts"
    },
    "./cloudflare/api": {
      "types": "./src/cloudflare/api.ts",
      "default": "./src/cloudflare/api.ts"
    },
    "./cloudflare/directives": {
      "types": "./src/cloudflare/directives.ts",
      "default": "./src/cloudflare/directives.ts"
    },
    "./cloudflare/vite": {
      "types": "./src/cloudflare/vite.ts",
      "default": "./src/cloudflare/vite.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.d.ts",
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./workflow": {
        "types": "./dist/workflow.d.mts",
        "import": "./dist/workflow.mjs",
        "default": "./dist/workflow.mjs"
      },
      "./effect": {
        "types": "./dist/effect.d.mts",
        "import": "./dist/effect.mjs",
        "default": "./dist/effect.mjs"
      },
      "./testing": {
        "types": "./dist/testing/index.d.mts",
        "import": "./dist/testing/index.mjs",
        "default": "./dist/testing/index.mjs"
      },
      "./cloudflare": {
        "types": "./dist/cloudflare/index.d.mts",
        "import": "./dist/cloudflare/index.mjs",
        "default": "./dist/cloudflare/index.mjs"
      },
      "./cloudflare/workflow": {
        "types": "./dist/cloudflare/workflow.d.mts",
        "import": "./dist/cloudflare/workflow.mjs",
        "default": "./dist/cloudflare/workflow.mjs"
      },
      "./cloudflare/api": {
        "types": "./dist/cloudflare/api.d.mts",
        "import": "./dist/cloudflare/api.mjs",
        "default": "./dist/cloudflare/api.mjs"
      },
      "./cloudflare/directives": {
        "types": "./dist/cloudflare/directives.d.mts",
        "import": "./dist/cloudflare/directives.mjs",
        "default": "./dist/cloudflare/directives.mjs"
      },
      "./cloudflare/vite": {
        "types": "./dist/cloudflare/vite.d.mts",
        "import": "./dist/cloudflare/vite.mjs",
        "default": "./dist/cloudflare/vite.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "effect-tsgo tsrs -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "devalue": "^6.0.3",
    "effect": "catalog:",
    "workflow": "^5.0.0-beta.42"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@workflow/vitest": "^5.0.0-beta.42",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  }
}
