{
  "name": "@yolk-sdk/openai",
  "version": "0.0.1-canary.10",
  "description": "OpenAI and Codex OAuth and provider mechanics for Yolk hosts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magoz/yolk-sdk.git",
    "directory": "packages/openai"
  },
  "bugs": {
    "url": "https://github.com/magoz/yolk-sdk/issues"
  },
  "homepage": "https://github.com/magoz/yolk-sdk#readme",
  "keywords": [
    "openai",
    "codex",
    "oauth",
    "agent",
    "effect"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./codex": {
      "types": "./src/codex.ts",
      "default": "./src/codex.ts"
    },
    "./codex-provider": {
      "types": "./src/codex-provider.ts",
      "default": "./src/codex-provider.ts"
    },
    "./provider": {
      "types": "./src/provider.ts",
      "default": "./src/provider.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./codex": {
        "types": "./dist/codex.d.mts",
        "import": "./dist/codex.mjs",
        "default": "./dist/codex.mjs"
      },
      "./codex-provider": {
        "types": "./dist/codex-provider.d.mts",
        "import": "./dist/codex-provider.mjs",
        "default": "./dist/codex-provider.mjs"
      },
      "./provider": {
        "types": "./dist/provider.d.mts",
        "import": "./dist/provider.mjs",
        "default": "./dist/provider.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@yolk-sdk/agent": "workspace:^",
    "@yolk-sdk/oauth": "workspace:^",
    "effect": "catalog:"
  }
}
