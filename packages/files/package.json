{
  "name": "@yolk-sdk/files",
  "version": "0.1.0-canary.115",
  "description": "File claim check for Yolk agents: an object-storage file store and tools that move captured files (fileId) to upload URLs, download links and the sandbox.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magoz/yolk-sdk.git",
    "directory": "packages/files"
  },
  "bugs": {
    "url": "https://github.com/magoz/yolk-sdk/issues"
  },
  "homepage": "https://github.com/magoz/yolk-sdk#readme",
  "keywords": [
    "files",
    "agents",
    "claim-check",
    "object-storage",
    "effect"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@yolk-sdk/sandbox": "workspace:^"
  },
  "dependencies": {
    "@yolk-sdk/agent": "workspace:^",
    "effect": "catalog:"
  }
}
