{
  "name": "@yolk-sdk/agent",
  "version": "0.0.1-canary.9",
  "description": "Protocol, loop, runtime, client, and tool primitives for building Yolk agents.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magoz/yolk-sdk.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/magoz/yolk-sdk/issues"
  },
  "homepage": "https://github.com/magoz/yolk-sdk#readme",
  "keywords": [
    "agent",
    "agents",
    "llm",
    "tools",
    "runtime",
    "effect"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./loop": {
      "types": "./src/loop/index.ts",
      "default": "./src/loop/index.ts"
    },
    "./loop/testing": {
      "types": "./src/loop/testing/index.ts",
      "default": "./src/loop/testing/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol/index.ts",
      "default": "./src/protocol/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "default": "./src/tools/index.ts"
    }
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist/**/*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./client": {
        "types": "./dist/client/index.d.mts",
        "import": "./dist/client/index.mjs",
        "default": "./dist/client/index.mjs"
      },
      "./loop": {
        "types": "./dist/loop/index.d.mts",
        "import": "./dist/loop/index.mjs",
        "default": "./dist/loop/index.mjs"
      },
      "./loop/testing": {
        "types": "./dist/loop/testing/index.d.mts",
        "import": "./dist/loop/testing/index.mjs",
        "default": "./dist/loop/testing/index.mjs"
      },
      "./protocol": {
        "types": "./dist/protocol/index.d.mts",
        "import": "./dist/protocol/index.mjs",
        "default": "./dist/protocol/index.mjs"
      },
      "./runtime": {
        "types": "./dist/runtime/index.d.mts",
        "import": "./dist/runtime/index.mjs",
        "default": "./dist/runtime/index.mjs"
      },
      "./tools": {
        "types": "./dist/tools/index.d.mts",
        "import": "./dist/tools/index.mjs",
        "default": "./dist/tools/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "effect": "catalog:"
  }
}
