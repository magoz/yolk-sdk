{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `scripts/check-formal-models.ts` runs everystate's launcher by path (its `exports` map hides
  // it from module resolution), which knip cannot see.
  "ignoreDependencies": ["everystate"],
  "workspaces": {
    "apps/docs": {
      // Loading next.config.ts runs fumadocs-mdx's createMDX, whose esbuild bundle of
      // source.config.ts fails under knip 6's loader; keep the Next.js entries without loading it.
      "next": { "config": [] },
      "ignore": ["next.config.ts"]
    }
  }
}
