{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/components/*": ["./components/*"],
      "@/lib/utils": ["./lib/utils"],
      "@/lib/*": ["./lib/*"],
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "instrumentation-client.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
