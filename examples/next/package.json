    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.1",
    "effect": "catalog:",
    "fflate": "^0.8.2",
    "input-otp": "^1.4.2",
    "just-bash": "^3.0.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "next": "16.1.3",
