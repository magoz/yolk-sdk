{
  "name": "@yolk-example/next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:db:push": "NODE_ENV=test tsx scripts/push-test-db.ts",
    "test:e2e": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test playwright test --config playwright.config.ts",
    "test:e2e:ui": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test playwright test --config playwright.config.ts --ui",
    "test:e2e:debug": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test playwright test --config playwright.config.ts --debug",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:push": "pnpm db:setup && drizzle-kit push --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@effect-aws/client-s3": "2.0.0-beta.4",
