{
  "name": "yolk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "portless",
    "dev:app": "pnpm --filter @yolk-example/next dev",
    "dev:tunnel": "ngrok http 4787",
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/*'",
    "build:examples": "turbo build --filter='./examples/*'",
    "start": "pnpm --filter @yolk-example/next start",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm tsc && pnpm lint && pnpm --filter './packages/*' check && pnpm cloudflare:check",
    "packages:build": "pnpm --filter './packages/*' build",
    "packages:boundaries": "tsx scripts/check-package-boundaries.ts",
    "packages:exports": "tsx scripts/check-package-exports.ts",
    "packages:publint": "tsx scripts/check-package-publint.ts",
    "packages:smoke": "tsx scripts/smoke-package-imports.ts",
    "packages:check": "pnpm --filter './packages/*' check && pnpm packages:boundaries && pnpm packages:exports",
    "cloudflare:check": "pnpm --filter './cloudflare/*' check",
    "cloudflare-agent:dev": "pnpm --filter @yolk-sdk/cloudflare-agent run dev",
    "cloudflare-agent:deploy": "pnpm --filter @yolk-sdk/cloudflare-agent run deploy",
    "cloudflare-agent:deploy:adopt": "pnpm --filter @yolk-sdk/cloudflare-agent exec alchemy deploy --adopt --force --yes",
    "cloudflare-agent:destroy": "pnpm --filter @yolk-sdk/cloudflare-agent run destroy",
    "cloudflare-agent:smoke": "pnpm --filter @yolk-sdk/cloudflare-agent run smoke",
    "changeset": "changeset",
    "changeset:canary:enter": "changeset pre enter canary",
    "changeset:canary:exit": "changeset pre exit",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "release:canary": "pnpm packages:build && changeset publish --tag canary",
    "codex-ws:smoke": "tsx scripts/codex-ws-smoke.ts",
    "skillset:build": "tsx scripts/build-skillset.ts",
    "clone-repos": "node --experimental-strip-types scripts/clone-repos.ts",
    "knip": "node --env-file .env.local node_modules/knip/bin/knip.js",
    "prettier:check": "pnpm prettier . --check",
    "prettier:fix": "pnpm prettier . --write",
    "test": "NODE_ENV=test vitest",
    "test:db:push": "NODE_ENV=test tsx scripts/push-test-db.ts",
    "test:run": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test vitest run --passWithNoTests && NODE_ENV=test pnpm --filter './packages/*' test:run",
    "test:e2e": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test playwright test",
    "test:e2e:ui": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test playwright test --ui",
    "test:e2e:debug": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test playwright test --debug",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:push": "pnpm db:setup && drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "portless": {
    "name": "yolk",
    "script": "dev:app"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@base-ui/react": "^1.1.0",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@neondatabase/serverless": "^1.0.2",
    "@opentelemetry/sdk-logs": "^0.210.0",
    "@opentelemetry/sdk-trace-node": "^2.4.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@yolk-sdk/agent": "workspace:^",
    "@yolk-sdk/anthropic": "workspace:^",
    "@yolk-sdk/knowledge": "workspace:^",
    "@yolk-sdk/mcp": "workspace:^",
    "@yolk-sdk/oauth": "workspace:^",
    "@yolk-sdk/openai": "workspace:^",
    "@yolk-sdk/rag": "workspace:^",
    "@yolk-sdk/react": "workspace:^",
    "@yolk-sdk/skillset": "workspace:^",
    "@yolk-sdk/vercel-workflows-runtime": "workspace:^",
    "@yolk-sdk/voice-runtime": "workspace:^",
    "better-auth": "^1.4.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.1",
    "effect": "catalog:",
    "fflate": "^0.8.2",
    "input-otp": "^1.4.2",
    "just-bash": "^3.0.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "next": "16.1.3",
    "nuqs": "^2.8.6",
    "posthog-js": "^1.327.0",
    "prettier": "^3.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.7.0",
    "shadcn": "^3.7.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "workflow": "^4.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "1.0.0-rc.1",
    "drizzle-seed": "1.0.0-rc.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "knip": "^5.81.0",
    "portless": "^0.13.0",
    "publint": "^0.3.21",
    "tailwindcss": "^4.1.18",
    "tsdown": "^0.22.0",
    "turbo": "^2.8.13",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "catalog:"
  },
  "overrides": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3"
  }
}
