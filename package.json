{
  "name": "yolk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "portless",
    "dev:app": "pnpm --filter @yolk-example/next dev",
    "dev:docs": "pnpm --filter @yolk-docs/site dev",
    "dev:tunnel": "ngrok http 4787",
    "build": "turbo build",
    "build:packages": "turbo build --filter='./packages/*'",
    "build:apps": "turbo build --filter='./apps/*'",
    "build:docs": "pnpm --filter @yolk-docs/site build",
    "build:examples": "turbo build --filter='./examples/*'",
    "start": "pnpm --filter @yolk-example/next start",
    "start:docs": "pnpm --filter @yolk-docs/site start",
    "docs:typegen": "pnpm --filter @yolk-docs/site typegen",
    "docs:check": "pnpm --filter @yolk-docs/site check",
    "tsc": "pnpm docs:check && tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm tsc && pnpm lint && pnpm docs:check && pnpm --filter './packages/*' check && pnpm cloudflare:check",
    "packages:build": "pnpm --filter './packages/*' build",
    "packages:boundaries": "tsx scripts/check-package-boundaries.ts",
    "packages:exports": "tsx scripts/check-package-exports.ts",
    "packages:publint": "tsx scripts/check-package-publint.ts",
    "packages:smoke": "tsx scripts/smoke-package-imports.ts",
    "packages:check": "pnpm --filter './packages/*' check && pnpm packages:boundaries && pnpm packages:exports",
    "cloudflare:check": "pnpm --filter './cloudflare/*' check",
    "cloudflare-agent:dev": "pnpm --filter @yolk-sdk/cloudflare-agent run dev",
    "cloudflare-agent:deploy": "pnpm --filter @yolk-sdk/cloudflare-agent run deploy",
    "cloudflare-agent:deploy:adopt": "pnpm --filter @yolk-sdk/cloudflare-agent exec alchemy deploy --adopt --force --yes",
    "cloudflare-agent:destroy": "pnpm --filter @yolk-sdk/cloudflare-agent run destroy",
    "cloudflare-agent:smoke": "pnpm --filter @yolk-sdk/cloudflare-agent run smoke",
    "changeset": "changeset",
    "changeset:canary:enter": "changeset pre enter canary",
    "changeset:canary:exit": "changeset pre exit",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "codex-ws:smoke": "tsx scripts/codex-ws-smoke.ts",
    "skillset:build": "tsx scripts/build-skillset.ts",
    "clone-repos": "node --experimental-strip-types scripts/clone-repos.ts",
    "knip": "node --env-file examples/next/.env.local node_modules/knip/bin/knip.js",
    "prettier:check": "pnpm prettier . --check",
    "prettier:fix": "pnpm prettier . --write",
    "test": "NODE_ENV=test vitest",
    "test:db:push": "NODE_ENV=test pnpm --filter @yolk-example/next test:db:push",
    "test:run": "NODE_ENV=test pnpm test:db:push && NODE_ENV=test vitest run --passWithNoTests && NODE_ENV=test pnpm --filter './packages/*' test:run",
    "test:e2e": "pnpm --filter @yolk-example/next test:e2e",
    "test:e2e:ui": "pnpm --filter @yolk-example/next test:e2e:ui",
    "test:e2e:debug": "pnpm --filter @yolk-example/next test:e2e:debug",
    "db:generate": "pnpm --filter @yolk-example/next db:generate",
    "db:setup": "pnpm --filter @yolk-example/next db:setup",
    "db:push": "pnpm --filter @yolk-example/next db:push",
    "db:studio": "pnpm --filter @yolk-example/next db:studio"
  },
  "portless": {
    "name": "yolk",
    "script": "dev:app"
  },
  "dependencies": {
    "@yolk-sdk/agent": "workspace:^",
    "drizzle-orm": "1.0.0-rc.1",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "^25.0.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "knip": "^5.81.0",
    "next": "16.1.3",
    "portless": "^0.13.0",
    "prettier": "^3.8.0",
    "publint": "^0.3.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsdown": "^0.22.0",
    "turbo": "^2.8.13",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "catalog:"
  },
  "overrides": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3"
  }
}
