{
  "name": "yolk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "PORT=4787 portless run next dev",
    "dev:app": "next dev -p 4787",
    "dev:tunnel": "ngrok http 4787",
    "build": "next build && pnpm --filter './packages/*' build",
    "start": "next start",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm tsc && pnpm lint && pnpm --filter './packages/*' check && pnpm cloudflare:check",
    "packages:build": "pnpm --filter './packages/*' build",
    "packages:boundaries": "tsx scripts/check-package-boundaries.ts",
    "packages:check": "pnpm --filter './packages/*' check && pnpm packages:boundaries",
    "cloudflare:check": "pnpm --filter './cloudflare/*' check",
    "cloudflare-agent:dev": "pnpm --filter @yolk/cloudflare-agent run dev",
    "cloudflare-agent:deploy": "pnpm --filter @yolk/cloudflare-agent run deploy",
    "cloudflare-agent:deploy:adopt": "pnpm --filter @yolk/cloudflare-agent exec alchemy deploy --adopt --force --yes",
    "cloudflare-agent:destroy": "pnpm --filter @yolk/cloudflare-agent run destroy",
    "cloudflare-agent:smoke": "pnpm --filter @yolk/cloudflare-agent run smoke",
    "codex-ws:smoke": "tsx scripts/codex-ws-smoke.ts",
    "skillset:build": "tsx scripts/build-skillset.ts",
    "clone-repos": "node --experimental-strip-types scripts/clone-repos.ts",
    "knip": "node --env-file .env.local node_modules/knip/bin/knip.js",
    "prettier:check": "pnpm prettier . --check",
    "prettier:fix": "pnpm prettier . --write",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests && pnpm --filter './packages/*' test:run",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:ui": "NODE_ENV=test playwright test --ui",
    "test:e2e:debug": "NODE_ENV=test playwright test --debug",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "portless": "yolk",
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@neondatabase/serverless": "^1.0.2",
    "@opentelemetry/sdk-logs": "^0.210.0",
    "@opentelemetry/sdk-trace-node": "^2.4.0",
    "@paralleldrive/cuid2": "^3.0.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.34.0",
    "@sentry/opentelemetry": "^10.34.0",
    "@yolk/agent": "workspace:^",
    "@yolk/anthropic": "workspace:^",
    "@yolk/mcp": "workspace:^",
    "@yolk/oauth": "workspace:^",
    "@yolk/openai": "workspace:^",
    "@yolk/react": "workspace:^",
    "@yolk/skillset": "workspace:^",
    "@yolk/vercel-workflows-runtime": "workspace:^",
    "@yolk/voice-runtime": "workspace:^",
    "better-auth": "^1.4.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.1",
    "effect": "catalog:",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next": "16.1.3",
    "nuqs": "^2.8.6",
    "posthog-js": "^1.327.0",
    "prettier": "^3.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.7.0",
    "shadcn": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.2.4"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "1.0.0-rc.1",
    "drizzle-seed": "1.0.0-rc.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "knip": "^5.81.0",
    "portless": "^0.13.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "catalog:"
  },
  "overrides": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3"
  }
}
